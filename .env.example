# Local profile: deterministic clients, persistent SQLite, and no API key.
PAPEROPS_ARTIFACTS_DIR=artifacts
PAPEROPS_KNOWLEDGE_DIR=knowledge
PAPEROPS_CHECKPOINT_DB=paperops.db
PAPEROPS_CLIENT_MODE=fake
PAPEROPS_MAX_PARSE_ATTEMPTS=2
PAPEROPS_MIN_MARKDOWN_CHARACTERS=120
PAPEROPS_MIN_SECTION_COUNT=1
PAPEROPS_MAX_REPLACEMENT_CHARACTER_RATIO=0.01
PAPEROPS_MIN_RETRIEVAL_HITS=1
PAPEROPS_RETRIEVAL_PROBE_TOP_K=10

# Real profile: use MinerU plus the native SQLite FTS5 retrieval baseline.
# PAPEROPS_CLIENT_MODE=real
# PAPEROPS_MINERU_BASE_URL=http://localhost:8000
# PAPEROPS_MINERU_BACKEND=pipeline
# PAPEROPS_MINERU_PARSE_METHOD=auto
# PAPEROPS_MINERU_TASK_TIMEOUT_SECONDS=1800
# PAPEROPS_EXTERNAL_TRUST_ENV=false
# PAPEROPS_RETRIEVAL_BACKEND=native
# PAPEROPS_NATIVE_INDEX_DB=paperops-index.db
# PAPEROPS_NATIVE_CHUNK_SIZE_CHARS=1200
# PAPEROPS_NATIVE_CHUNK_OVERLAP_CHARS=160
# PAPEROPS_NATIVE_SEARCH_TOP_K=10

# Optional local model-backed retrieval. Install with
# `uv sync --extra retrieval-models`, then choose dense, hybrid, or
# hybrid_reranked. Native BM25 remains the dependency-free default.
# PAPEROPS_RETRIEVAL_BACKEND=hybrid
# PAPEROPS_RETRIEVAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# PAPEROPS_RETRIEVAL_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# PAPEROPS_RETRIEVAL_MODEL_CACHE_DIR=.paperops-models
# PAPEROPS_RETRIEVAL_CANDIDATE_K=20
# PAPEROPS_RETRIEVAL_RRF_K=60

# Research-query graph and PR7 paired evaluation. Fake mode needs no key.
PAPEROPS_RESEARCH_MODEL_MODE=fake
PAPEROPS_RESEARCH_SEARCH_TOP_K=10
PAPEROPS_RESEARCH_MAX_REWRITES=2
PAPEROPS_RESEARCH_MIN_EVIDENCE_HITS=1
PAPEROPS_RESEARCH_MIN_ASSESSMENT_CONFIDENCE=0.65
PAPEROPS_RESEARCH_MAX_SELECTED_EVIDENCE=5
PAPEROPS_RESEARCH_STOP_ON_STAGNANT_RETRIEVAL=true
PAPEROPS_RESEARCH_MAX_CHUNK_CHARS=1600
PAPEROPS_RESEARCH_MAX_EVIDENCE_CHARS=16000

# Optional JSON-mode OpenAI-compatible chat-completions endpoint.
# Keep the key in the untracked .env only.
# PAPEROPS_RESEARCH_MODEL_MODE=openai_compatible
# PAPEROPS_RESEARCH_MODEL_BASE_URL=https://api.openai.com/v1
# PAPEROPS_RESEARCH_MODEL_API_KEY=your-model-api-key-here
# PAPEROPS_RESEARCH_MODEL_NAME=gpt-4o-mini
# PAPEROPS_RESEARCH_MODEL_PROXY_URL=http://127.0.0.1:7890
# PAPEROPS_RESEARCH_MODEL_TIMEOUT_SECONDS=90

# Optional external backend. Keep the RAGFlow key in the untracked .env only.
# PAPEROPS_RETRIEVAL_BACKEND=ragflow
# PAPEROPS_RAGFLOW_BASE_URL=http://localhost:9380
# PAPEROPS_RAGFLOW_API_KEY=your-ragflow-api-key-here
# PAPEROPS_RAGFLOW_INDEX_TIMEOUT_SECONDS=900
