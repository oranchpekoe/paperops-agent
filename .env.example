# Legacy v0.1 multi-mode graph only
TAVILY_API_KEY=your-tavily-api-key-here

# To separate your traces from other application
LANGSMITH_PROJECT=paperops-agent

# PaperOps local paths (PR1 defaults)
PAPEROPS_ARTIFACTS_DIR=artifacts
PAPEROPS_KNOWLEDGE_DIR=knowledge
PAPEROPS_MAX_PARSE_ATTEMPTS=2

# MinerU and RAGFlow are connected in PR3. Keep secrets in .env only.
# PAPEROPS_MINERU_BASE_URL=http://localhost:8001
# PAPEROPS_RAGFLOW_BASE_URL=http://localhost:9380
# PAPEROPS_RAGFLOW_API_KEY=your-ragflow-api-key-here

# Model configuration
MODEL=openai/deepseek-v4-flash
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key-here

# Optional: for Anthropic models
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: for Fireworks models
# FIREWORKS_API_KEY=your-fireworks-api-key-here

# Optional: embedding model for long-term memory & RAG
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: Chroma persistence directory
# CHROMA_PERSIST_DIR=.chroma_db

# Optional legacy MCP server configuration (JSON string or path to JSON file)
# MCP_CONFIG={"demo":{"command":"python","args":["mcp_demo_server.py"],"transport":"stdio"}}
