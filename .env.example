# Local profile: deterministic clients, persistent SQLite, and no API key.
PAPEROPS_ARTIFACTS_DIR=artifacts
PAPEROPS_KNOWLEDGE_DIR=knowledge
PAPEROPS_CHECKPOINT_DB=paperops.db
PAPEROPS_CLIENT_MODE=fake
PAPEROPS_MAX_PARSE_ATTEMPTS=2
PAPEROPS_MIN_MARKDOWN_CHARACTERS=120
PAPEROPS_MIN_SECTION_COUNT=1
PAPEROPS_MAX_REPLACEMENT_CHARACTER_RATIO=0.01
PAPEROPS_MIN_RETRIEVAL_HITS=1
PAPEROPS_RETRIEVAL_PROBE_TOP_K=10

# Real profile: use MinerU plus the native SQLite FTS5 retrieval baseline.
# PAPEROPS_CLIENT_MODE=real
# PAPEROPS_MINERU_BASE_URL=http://localhost:8000
# PAPEROPS_MINERU_BACKEND=pipeline
# PAPEROPS_MINERU_PARSE_METHOD=auto
# PAPEROPS_MINERU_TASK_TIMEOUT_SECONDS=1800
# PAPEROPS_EXTERNAL_TRUST_ENV=false
# PAPEROPS_RETRIEVAL_BACKEND=native
# PAPEROPS_NATIVE_INDEX_DB=paperops-index.db
# PAPEROPS_NATIVE_CHUNK_SIZE_CHARS=1200
# PAPEROPS_NATIVE_CHUNK_OVERLAP_CHARS=160
# PAPEROPS_NATIVE_SEARCH_TOP_K=10

# Optional external backend. Keep the RAGFlow key in the untracked .env only.
# PAPEROPS_RETRIEVAL_BACKEND=ragflow
# PAPEROPS_RAGFLOW_BASE_URL=http://localhost:9380
# PAPEROPS_RAGFLOW_API_KEY=your-ragflow-api-key-here
# PAPEROPS_RAGFLOW_INDEX_TIMEOUT_SECONDS=900
