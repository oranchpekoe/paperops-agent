TAVILY_API_KEY=your-tavily-api-key-here

# To separate your traces from other application
LANGSMITH_PROJECT=react-agent

# Model configuration
MODEL=openai/deepseek-v4-flash
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key-here

# Optional: for Anthropic models
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: for Fireworks models
# FIREWORKS_API_KEY=your-fireworks-api-key-here

# Optional: embedding model for long-term memory & RAG
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: Chroma persistence directory
# CHROMA_PERSIST_DIR=.chroma_db

# Optional: MCP server configuration (JSON string or path to JSON file)
# MCP_CONFIG={"servers": []}
